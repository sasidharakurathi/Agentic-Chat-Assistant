# ─────────────────────────────────────────────────────────────
# Assistant Studio — environment
# Copy to .env and fill in. The API refuses to boot in production
# if JWT_SECRET / APP_KEK / ANTHROPIC_API_KEY are unset or default.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_ENV=dev                       # dev | test | production
APP_NAME=Assistant Studio
APP_BASE_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                # console | json  (use json in production)
CORS_ORIGINS=http://localhost:3000

# ── Auth / crypto ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900        # 15 min
JWT_REFRESH_TTL_SECONDS=2592000   # 30 days

# Envelope-encryption master key (used from Phase 3 onward).
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
APP_KEK=

# ── Datastores ───────────────────────────────────────────────
# The compose stack publishes Postgres on 55432 and Redis on 56379 to avoid
# colliding with locally-installed services. For a no-Docker start, use SQLite:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://app:app@localhost:55432/app
REDIS_URL=redis://localhost:56379/0
# Override the published host ports if these are also taken:
# POSTGRES_PORT=55432
# REDIS_PORT=56379

# ── Object storage (MinIO / S3) — used from Phase 2 ───────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assistant-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Model / retrieval providers — used from Phase 1 / 2 ───────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
RAG_OFFLINE=0

# ── Agent runtime ────────────────────────────────────────────
AGENT_MAX_CONCURRENCY=8
APPROVAL_TIMEOUT_S=300

# ── Observability (optional) ─────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Seed script (just seed) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ORG_NAME=Demo Org

# ── Frontend (apps/web) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
