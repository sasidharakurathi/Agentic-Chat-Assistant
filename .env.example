# ─────────────────────────────────────────────────────────────
# Assistant Studio — environment
# Copy to .env and fill in. The API refuses to boot in production
# if JWT_SECRET / APP_KEK / ANTHROPIC_API_KEY are unset or default.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# dev | test | production
APP_ENV=dev
APP_NAME=Assistant Studio
APP_BASE_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console | json  (use json in production)
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth / crypto ────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
# 15 min
JWT_ACCESS_TTL_SECONDS=900
# 30 days
JWT_REFRESH_TTL_SECONDS=2592000

# Envelope-encryption master key (used from Phase 3 onward).
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
APP_KEK=

# ── Datastores ───────────────────────────────────────────────
# The compose stack publishes Postgres on 45432 and Redis on 46379 to avoid
# colliding with locally-installed services. Keep host ports below 49152: on
# Windows, Hyper-V reserves random blocks of 49152-65535 at every boot (see
# docker-compose.yml). For a no-Docker start, use SQLite:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://app:app@localhost:45432/app
REDIS_URL=redis://localhost:46379/0
# Override the published host ports if these are also taken:
# POSTGRES_PORT=45432
# REDIS_PORT=46379

# ── Object storage (MinIO / S3) — used from Phase 2 ───────────
S3_ENDPOINT=http://localhost:9000
# Where the browser reaches object storage, if that differs from where the
# API does (inside Docker the API uses http://minio:9000). Citation deep
# links are presigned URLs the browser opens directly. Empty = same as above.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=assistant-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Model / retrieval providers — used from Phase 1 / 2 ───────
# Adding a key here never starts spending credits by itself — AGENT_DRIVER
# and RAG_OFFLINE below keep dev on the free offline paths until you
# deliberately flip one for a one-off real check.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Offline mode: local embeddings/reranking, and web search switched off for
# every assistant (a search sends the query to a third party).
RAG_OFFLINE=1

# ── Agent runtime ────────────────────────────────────────────
# auto = real SDK once ANTHROPIC_API_KEY is set (and APP_ENV != test), else
# fake. Keep this pinned to "fake" for normal dev/testing.
AGENT_DRIVER=fake
AGENT_MAX_CONCURRENCY=8
APPROVAL_TIMEOUT_S=300

# ── Rate limiting (task 5.8) ─────────────────────────────────
# Token buckets in Redis; each limit is "<requests>/<seconds>". The defaults
# (app/config.py) suit one team; set any of these to change one.
RATE_LIMIT_ENABLED=1
# Reverse proxies in front of the API that append to X-Forwarded-For. 0 (no
# proxy, as docker-compose runs it): the header is ignored.
TRUSTED_PROXY_HOPS=0
# RATE_LIMIT_IP=600/60
# RATE_LIMIT_USER=1200/60
# RATE_LIMIT_AUTH=20/60
# RATE_LIMIT_LOGIN=10/300
# RATE_LIMIT_CHAT_USER=30/60
# RATE_LIMIT_CHAT_ORG=300/60
# RATE_LIMIT_ASSIST=10/60
# RATE_LIMIT_HEAVY=30/60

# ── MCP servers (Phase 4) ────────────────────────────────────
# Accept plain http:// MCP server URLs. Leave off: headers usually carry a
# credential. Only for a server running on this machine while testing.
MCP_ALLOW_INSECURE_URLS=0
# The MCP runner (task 4.4): local-command (stdio) MCP servers run there,
# never inside the API. scripts/dev-mcp-runner.ps1 starts one on this machine;
# in Docker it is the mcp-runner container.
MCP_RUNNER_URL=http://127.0.0.1:8100
# Shared by the API and the runner only. setup.ps1 generates one. Left empty
# in development, it is derived from APP_KEK; production requires it, and so
# does the Docker runner (it is never given APP_KEK).
MCP_RUNNER_TOKEN=

# ── Observability (optional, task 1.9) ───────────────────────
# Needs the `observability` extra (the Docker image has it).
# An OTLP/HTTP collector's base URL (e.g. http://localhost:4318); gets every span.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Langfuse v3 (>= 3.22) gets the chat-turn spans only. The local stack in
# docker-compose.observability.yml creates a project with these keys:
#   LANGFUSE_HOST=http://localhost:3001
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
#   LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# The same Langfuse as seen from the `apps` profile containers.
LANGFUSE_DOCKER_HOST=http://langfuse-web:3000

# ── Seed script (just seed) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_ORG_NAME=Demo Org

# ── Frontend (apps/web) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
