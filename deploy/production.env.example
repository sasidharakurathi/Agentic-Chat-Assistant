# Settings for docker-compose.prod.yml (task 6.6).
#
#   cp deploy/production.env.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Keep the filled-in file out of version control and readable only by you
# (`chmod 600 .env.production`). Every value marked REQUIRED stops the stack
# from starting while it is empty.
#
# To generate values (any machine with Python):
#   a secret:             python -c "import secrets; print(secrets.token_urlsafe(48))"
#   letters and digits:   python -c "import secrets; print(secrets.token_hex(24))"
#   APP_KEK:              python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

# ── Where it lives ───────────────────────────────────────────
# REQUIRED. The host name people open, without https://. Its DNS must point
# at this machine and ports 80 and 443 must be reachable, so the proxy can
# get a certificate. `localhost` works for a trial (self-signed).
# Changing it later means rebuilding the web image (`up -d --build`).
DOMAIN=

# ── Secrets ──────────────────────────────────────────────────
# REQUIRED. Signs sign-in tokens. 32+ characters. Changing it signs everyone out.
JWT_SECRET=
# REQUIRED. Encrypts stored credentials (database passwords, MCP headers).
# Base64 of 32 random bytes. BACK THIS UP SEPARATELY FROM THE DATABASE: a
# database backup cannot be read without it, and it cannot be recovered.
# To change it later: `python -m scripts.rotate_kek` (docs/EXPLAINER.md).
APP_KEK=
# REQUIRED. An API key from the Claude Console. Every assistant on this
# server runs on it.
ANTHROPIC_API_KEY=
# For the knowledge base's embeddings and reranking. Leave empty and set
# RAG_OFFLINE=1 to use the local model instead (free, slower, less accurate).
VOYAGE_API_KEY=
RAG_OFFLINE=0
# auto: the real model. fake: canned answers and no model calls, for trying
# the stack at no cost (ANTHROPIC_API_KEY must still be non-empty).
AGENT_DRIVER=auto

# ── Datastores ───────────────────────────────────────────────
# REQUIRED. Letters and digits only: they are placed inside URLs.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# REQUIRED. MinIO's root user and password (8+ characters for the password).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=assistant-uploads

# ── Local-command MCP servers ────────────────────────────────
# REQUIRED. The API's password to the runner container.
MCP_RUNNER_TOKEN=

# ── Who may sign up ──────────────────────────────────────────
# invite: the first account (you, on a new install), then only people
#         holding an invite link. Every account can use the model key, so
#         this is the setting for a server on the internet.
# open:   anyone who can reach the server.
REGISTRATION=invite

# ── Capacity (docs/EXPLAINER.md §12.5) ───────────────────────
# Turns running at once in the API; each is a subprocess. The rest queue.
AGENT_MAX_CONCURRENCY=8
API_MEMORY=4g
WORKER_MEMORY=4g

# ── Observability (optional) ─────────────────────────────────
# A bearer token for GET /metrics. Empty: the page is switched off. The
# proxy never publishes /metrics either way.
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Images (optional) ────────────────────────────────────────
# A tag for the images this builds, so an upgrade can be rolled back.
APP_VERSION=latest
# Pin these to the releases you tested.
# CADDY_IMAGE=caddy:2
# MINIO_IMAGE=minio/minio:latest
# HTTP_PORT=80
# HTTPS_PORT=443
