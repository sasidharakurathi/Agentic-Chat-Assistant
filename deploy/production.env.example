# Settings for docker-compose.prod.yml (task 6.6).
#
#   cp deploy/production.env.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Keep the filled-in file out of version control and readable only by you
# (`chmod 600 .env.production`). Every value marked REQUIRED stops the stack
# from starting while it is empty.
#
# To generate values (any machine with Python):
#   a secret:             python -c "import secrets; print(secrets.token_urlsafe(48))"
#   letters and digits:   python -c "import secrets; print(secrets.token_hex(24))"
#   APP_KEK:              python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

# ── Where it lives ───────────────────────────────────────────
# REQUIRED. The host name people open, without https://: one name for the
# office, the VPN and phones alike (it is baked into links and the web
# image). `localhost` works for a trial (TLS_MODE=local).
# Changing it later means rebuilding the web image (`up -d --build`).
DOMAIN=

# How the proxy gets its certificate (Phase 8.2, OPERATIONS §2):
#   acmedns or cloudflare: through DNS, for a server only the office and
#     the VPN reach (the internal install). Needs CADDY_IMAGE built from
#     deploy/proxy/caddy.Dockerfile.
#   public: the name's public DNS points here, ports 80 and 443 open to the
#     internet.
#   local: Caddy's own CA (a trial on localhost).
TLS_MODE=public
# The one address the proxy listens on: the server's office-LAN address,
# or its Tailscale address (100.x). Empty is every interface.
# BIND_IP=
# TLS_MODE=cloudflare: a token that may edit DNS of this one zone only.
# CLOUDFLARE_API_TOKEN=
# TLS_MODE=acmedns: the account from registering with an acme-dns server,
# whose fulldomain _acme-challenge.<DOMAIN> is a CNAME to.
# ACMEDNS_USERNAME=
# ACMEDNS_PASSWORD=
# ACMEDNS_SUBDOMAIN=
# ACMEDNS_SERVER_URL=https://auth.acme-dns.io

# ── Secrets ──────────────────────────────────────────────────
# REQUIRED. Signs sign-in tokens. 32+ characters. Changing it signs everyone out.
JWT_SECRET=
# REQUIRED. Encrypts stored credentials (database passwords, MCP headers).
# Base64 of 32 random bytes. BACK THIS UP SEPARATELY FROM THE DATABASE: a
# database backup cannot be read without it, and it cannot be recovered.
# To change it later: `python -m scripts.rotate_kek` (docs/EXPLAINER.md).
APP_KEK=
# REQUIRED. An API key from the Claude Console. Every assistant on this
# server runs on it.
ANTHROPIC_API_KEY=
# For the knowledge base's embeddings and reranking. Leave empty and set
# RAG_OFFLINE=1 to use the local model instead (free, slower, less accurate).
VOYAGE_API_KEY=
RAG_OFFLINE=0
# auto: the real model. fake: canned answers and no model calls, for trying
# the stack at no cost (ANTHROPIC_API_KEY must still be non-empty).
AGENT_DRIVER=auto

# ── Datastores ───────────────────────────────────────────────
# REQUIRED. Letters and digits only: they are placed inside URLs.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# REQUIRED. MinIO's root user and password (8+ characters for the password).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=assistant-uploads

# ── Local-command MCP servers ────────────────────────────────
# REQUIRED. The API's password to the runner container.
MCP_RUNNER_TOKEN=

# ── Who may sign up ──────────────────────────────────────────
# invite: the first account (you, on a new install), then only people
#         holding an invite link. Every account can use the model key, so
#         this is the setting for a server on the internet.
# open:   anyone who can reach the server.
REGISTRATION=invite
# How long an invite link stays open, in days (1 to 60).
# INVITE_TTL_DAYS=7
# One company organisation (Phase 7b.8): nobody creates another, and
# sign-up is by invite. multi lets anyone signed in create one.
# ORG_MODE=single

# ── Google sign-in (docs/EXPLAINER.md §18, 8.3) ──────────────
# An OAuth client in the company's Google Cloud project: consent screen
# type Internal, client type Web application, redirect URI
# https://<DOMAIN>/api/v1/auth/google/callback (OPERATIONS §2). Both empty:
# off, and people sign in with passwords.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The company's Google Workspace domain (example.com): only its accounts
# may sign in with Google. Needed for auto-join (Members › Organisation).
# GOOGLE_ALLOWED_DOMAIN=

# ── Two-step sign-in and limits (docs/EXPLAINER.md §18, 8.4) ──
# The owner and admins act as admins only after a second factor: a code
# from an authenticator app, or a Google sign-in limited to the domain
# above. Without one, they act as builders until they set it up.
# REQUIRE_ADMIN_2FA=true
# Office and VPN address ranges where many people share one address, so
# per-address limits are much higher there (per-person limits still apply).
# TRUSTED_INTERNAL_NETS=10.0.0.0/8,100.64.0.0/10

# ── Email (docs/EXPLAINER.md §17, 7b.5) ──────────────────────
# Invites, versions waiting for review, and reviews done. Without SMTP_HOST
# nothing is emailed: invite links are copied by hand. Prefer a mailbox the
# company controls (a Workspace account or a send-only address) to a
# personal gmail.com one: an app password opens the whole account.
# Gmail: smtp.gmail.com, port 587, STARTTLS, an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=notifications@your-company.example
# SMTP_PASSWORD=<an app password>
# MAIL_FROM=notifications@your-company.example
# MAIL_FROM_NAME=Assistant Studio

# ── Capacity (docs/EXPLAINER.md §12.5) ───────────────────────
# Turns running at once in the API; each is a subprocess. The rest queue.
AGENT_MAX_CONCURRENCY=8
API_MEMORY=4g
WORKER_MEMORY=4g

# ── Observability (optional) ─────────────────────────────────
# A bearer token for GET /metrics. Empty: the page is switched off. The
# proxy never publishes /metrics either way.
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Models (optional) ────────────────────────────────────────
# Assistants name a family ("haiku", "sonnet", "opus", "fable"), and each
# runs as that family's current model. Repoint one here, as JSON, and every
# assistant on it moves with no new version. The preflight refuses an
# unknown alias or model id. Example, when a new Haiku ships:
# MODEL_ALIASES={"haiku":"claude-haiku-5"}

# ── Images (optional) ────────────────────────────────────────
# A tag for the images this builds, so an upgrade can be rolled back.
APP_VERSION=latest
# Pin these to the releases you tested.
# CADDY_IMAGE=caddy:2   (assistant-studio-proxy:2.10 for TLS_MODE acmedns or cloudflare)
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:e7ca559d9f7c0b5f24f5f669bb92f40f3ca88d56273b808bf3a7c116c17d2ffa
# HTTP_PORT=80
# HTTPS_PORT=443
