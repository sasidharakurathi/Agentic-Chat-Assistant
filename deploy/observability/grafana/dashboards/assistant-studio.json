{
  "uid": "assistant-studio",
  "title": "Assistant Studio",
  "tags": [
    "assistant-studio"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Spend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spend per hour, by model",
      "description": "What the platform is spending, from the usage ledger.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "sum by (model) (rate(assistant_studio_cost_usd_total[1h])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Spend per hour, by assistant",
      "description": "The ten assistants spending the most.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "topk(10, sum by (assistant) (rate(assistant_studio_assistant_cost_usd_total[1h])) * 3600)",
          "legendFormat": "{{assistant}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Budgets used",
      "description": "Each budget against its limit. Chats are warned from 80% and refused at 100%.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "assistant_studio_budget_used_ratio",
          "legendFormat": "{{scope}} ({{period}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Requests and the error budget",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests per second, by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "sum by (status) (rate(assistant_studio_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests failing (5xx)",
      "description": "The error budget: the alert fires above 5% for 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "sum(rate(assistant_studio_http_requests_total{status=\"5xx\"}[5m])) / sum(rate(assistant_studio_http_requests_total[5m]))",
          "legendFormat": "5xx share",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request time, 95th percentile by route",
      "description": "The eight slowest routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(assistant_studio_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Agent turns",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Turn duration",
      "description": "From the message arriving to the answer being saved.",
      "datasource": {
        "type": "prometheus",
        "uid": "assistant-studio-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(assistant_studio_turn_duration_seconds_bucket[15m])))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_studio_turn_duration_seconds_bucket[15m])))",
          "legendFormat": "95th percentile",
          "refId": "B"
        }
      ]
    },
