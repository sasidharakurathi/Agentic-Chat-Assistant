      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "assistant-studio-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(assistant_studio_tool_duration_seconds_bucket[15m])))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ]
    },
