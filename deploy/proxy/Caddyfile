# The one way in (task 6.6): TLS, then routing by path. Started by
# docker-compose.prod.yml; see docs/EXPLAINER.md §12.6.
#
# SITE_ADDRESS is the host name people open. For a real domain whose DNS
# points here, Caddy gets and renews a certificate by itself (ports 80 and
# 443 must be reachable from the internet). For `localhost` it signs one
# with its own local CA, which a browser will warn about until that CA is
# trusted: fine for trying the stack, not for users.
#
# A sample: Traefik, nginx or a cloud load balancer can do the same job.
# What any of them must do is in the comments below.

{$SITE_ADDRESS} {
	# Browsers must come back over HTTPS for a year. (Caddy already redirects
	# http:// to https://.)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Who connected, from where, and what they asked for (Phase 7a.8): the
	# containers' own logs are gone at the next `up -d --build`, and an
	# incident report to CERT-In needs 180 days. JSON, on its own volume
	# (`caddylogs`), kept 4392 h, about 183 days. Caddy leaves out the values
	# of Authorization and Cookie by itself; the filter takes out the two
	# credentials that travel in the address: an invite link's token (in the
	# path) and a file link's signature (in the query, so every query goes).
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 2000
			roll_keep_for 4392h
		}
		format filter {
			fields {
				request>uri regexp "(/invites/)[^/?]+|\?.*$" "${1}"
			}
			wrap json
		}
	}

	# The largest request the API should ever be asked to read: a document
	# upload. Refused here, before it costs the API anything.
	request_body {
		max_size 64MB
	}

	# Never published. /metrics reports spend and names orgs and assistants;
	# scrape it from inside (docs/EXPLAINER.md §12.4).
	handle /metrics {
		respond "Not found" 404
	}

	# The API. `flush_interval -1`: a chat answer is a stream of server-sent
	# events, and a proxy that buffers turns it into one long silence
	# followed by the whole answer. Long timeouts for the same reason: a
	# turn can wait minutes for someone to approve a tool call.
	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	# Citation links: URLs the API signs for this host and MinIO checks. The
	# Host header must reach MinIO unchanged (Caddy's default), or the
	# signature does not match. Only reads, only the one bucket.
	@files {
		method GET HEAD
		path /{$S3_BUCKET}/*
	}
	handle @files {
		# A second wall behind the API's choice of type and disposition
		# (storage/file_types.py): the browser must not guess a type, and
		# nothing served here may run a script, post a form or be framed.
		# No object-src or sandbox rule: those stop the browser's own PDF
		# viewer, and the PDFs here are the citations people open.
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "script-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
		reverse_proxy minio:9000
	}

	# Everything else is the web app.
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
