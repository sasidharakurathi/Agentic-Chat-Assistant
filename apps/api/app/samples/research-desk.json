{
  "id": "research-desk",
  "order": 3,
  "name": "Research desk",
  "description": "Looks things up on the web, hands longer digging to a research helper, and spends more effort on hard questions than on easy ones. Shows the full line: a router, a subagent and three tools.",
  "needs": [
    "Web search, which is switched off when the server runs offline (RAG_OFFLINE=1). The calculator and the clock work either way."
  ],
  "try_asking": [
    "Calculate 1840 * 0.175 and tell me what the result would be as a percentage of 9200.",
    "What is today's date, and how many days are left in this year?",
    "Research: what changed in the most recent stable release of PostgreSQL?"
  ],
