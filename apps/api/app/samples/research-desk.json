            "router": {
              "model": "claude-haiku-4-5",
              "effort": "high",
              "thinking": {
                "type": "adaptive"
              },
              "max_turns": null,
              "max_budget_usd": null
            },
            "main": {
              "model": "claude-sonnet-5",
              "effort": "high",
              "thinking": {
