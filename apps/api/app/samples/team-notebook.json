{
  "id": "team-notebook",
  "order": 2,
  "name": "Team notebook",
  "description": "Remembers what it is told from one conversation to the next: preferences, decisions, who owns what. Nothing to connect, so it works as it is.",
  "needs": [],
  "try_asking": [
    "Remember: our release day is Thursday and Priya signs off deployments.",
    "Memories: what do you know about our releases?",
    "Calculate 14 * 6 and remember the result as our sprint capacity in hours."
